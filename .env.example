# Copie para .env e preencha. O .env não entra no repositório (ver .gitignore).

# Postgres — string completa de conexão.
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# PocketBase — usado só para guardar as imagens dos veículos.
# O login abaixo é de superusuário (painel em /_/) e fica só no servidor; o
# navegador nunca o vê.
POCKETBASE_URL=https://db.a5ecossistema.tech
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
# Nome da coleção no PocketBase (já criada, com um campo de arquivo "imagem").
POCKETBASE_COLLECTION=cadastro_veiculos_imagens

# Login do painel (HTTP Basic Auth). Sem essas duas variáveis o serviço
# responde 503 em tudo que não for /saude — falha fechada, de propósito: é um
# cadastro que grava dados, não pode ficar aberto por esquecimento no deploy.
ADMIN_USER=
ADMIN_PASSWORD=

PORT=3000
